{
  "name": "@pristy/pristy-collabora-component",
  "description": "Collabora Online in Vue",
  "version": "0.5.0",
  "author": "JECI SARL",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CollaboraOnline/alfresco-collabora-online.git"
  },
  "keywords": [
    "collabora",
    "alfresco",
    "pristy",
    "vue"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/pristy-collabora-component.umd.js",
  "module": "./dist/pristy-collabora-component.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/pristy-collabora-component.es.js",
      "require": "./dist/pristy-collabora-component.umd.js"
    },
    "./dist/pristy-collabora-component.css": "./dist/pristy-collabora-component.css"
  },
  "unpkg": "./dist/pristy-collabora-component.umd.js",
  "jsdelivr": "./dist/pristy-collabora-component.umd.js",
  "scripts": {
    "dev": "vite",
    "build:library": "vite build",
    "build:dev": "vite build --minify false --sourcemap true",
    "serve": "vite preview",
    "analyze": "vite build --config analyze.config.js",
    "lint": "eslint --fix",
    "check": "eslint --quiet",
    "format": "prettier . --write",
    "optim:svg": "npx svgo -r -f public",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "testreport": "vitest run --reporter=junit --outputFile.junit=./testreport.xml"
  },
  "peerDependencies": {
    "vue": "^3.5.22"
  },
  "dependencies": {
    "axios": "^1.15.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@vitejs/plugin-legacy": "^7.2.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-vue": "^9.33.0",
    "prettier": "^3.8.3",
    "rollup-plugin-visualizer": "^6.0.11",
    "sass": "^1.99.0",
    "svgo": "^4.0.1",
    "vite": "^7.3.2",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^10.4.0"
  },
  "browserslist": [
    "defaults",
    ">1%, >= 0.3% in alt-EU",
    "last 2 versions",
    "Firefox ESR",
    "not ie 11",
    "not dead",
    "not ios_saf < 15"
  ]
}
