<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-3.0.xsd">

	<!-- Not WOPI Specs -->

	<bean id="webscript.fr.jeci.collabora.token.get"
		class="fr.jeci.collabora.alfresco.GetTokenWebScript"
		parent="webscript">
		<property name="collaboraOnlineService"
			ref="CollaboraOnlineService" />
	</bean>

	<bean id="webscript.fr.jeci.collabora.service-url.get"
		class="fr.jeci.collabora.alfresco.ServiceUrlInfoWebScript"
		parent="webscript">
		<property name="collaboraOnlineService"
			ref="CollaboraOnlineService" />
	</bean>

	<bean
		id="webscript.fr.jeci.collabora.aspect-collabora-online.clean-auto-version.post"
		class="fr.jeci.collabora.alfresco.CleanVersionWebScript"
		parent="webscript">
		<property name="versionService" ref="VersionService" />
	</bean>


	<!-- WOPI Specs -->

	<bean id="abstract-wopi-webscript" abstract="true"
		class="fr.jeci.collabora.wopi.AbstractWopiWebScript"
		parent="webscript">
		<property name="collaboraOnlineService"
			ref="CollaboraOnlineService" />
		<property name="nodeService" ref="NodeService" />
		<property name="contentService" ref="ContentService" />
		<property name="retryingTransactionHelper"
			ref="retryingTransactionHelper" />
		<property name="versionService" ref="VersionService" />
		<property name="prefixResolver" ref="namespaceService" />
		<property name="dictionaryService" ref="DictionaryService" />
		<property name="renditionService" ref="RenditionService2" />
		<property name="behaviourFilter" ref="policyBehaviourFilter"/>
		<property name="renditions" value="${fr.jeci.collabora.renditions}"/>
	</bean>

	<bean id="webscript.fr.jeci.collabora.wopi.CheckFileInfo.get"
		class="fr.jeci.collabora.wopi.WopiCheckFileInfoWebScript"
		parent="abstract-wopi-webscript">
		<property name="permissionService" ref="PermissionService" />
		<property name="authorityService" ref="AuthorityService" />
		<property name="personService" ref="PersonService" />
		<property name="featureRestrictionService" ref="FeatureRestrictionService" />
	</bean>

	<bean id="webscript.fr.jeci.collabora.wopi.GetFile.get"
		class="fr.jeci.collabora.wopi.WopiGetFileWebScript"
		parent="abstract-wopi-webscript">
	</bean>

	<bean id="webscript.fr.jeci.collabora.wopi.PutFile.post"
		class="fr.jeci.collabora.wopi.WopiPutFileWebScript"
		parent="abstract-wopi-webscript">
	</bean>

	<bean id="webscript.fr.jeci.collabora.wopi.PutRelativeFile.post"
		class="fr.jeci.collabora.wopi.WopiPutRelativeFileWebScript"
		parent="abstract-wopi-webscript">
		<property name="copyService" ref="CopyService" />
	</bean>


	<!-- License Management Webscripts -->

	<bean id="webscript.fr.jeci.collabora.license.license.get"
		class="fr.jeci.collabora.alfresco.restriction.LicenseListWebScript"
		parent="webscript">
		<property name="featureRestrictionService" ref="FeatureRestrictionService" />
	</bean>

	<bean id="webscript.fr.jeci.collabora.license.license-grant.post"
		class="fr.jeci.collabora.alfresco.restriction.LicenseGrantWebScript"
		parent="webscript">
		<property name="featureRestrictionService" ref="FeatureRestrictionService" />
	</bean>

	<bean id="webscript.fr.jeci.collabora.license.license-revoke.post"
		class="fr.jeci.collabora.alfresco.restriction.LicenseRevokeWebScript"
		parent="webscript">
		<property name="featureRestrictionService" ref="FeatureRestrictionService" />
	</bean>

	<bean id="webscript.fr.jeci.collabora.license.license-config.post"
		class="fr.jeci.collabora.alfresco.restriction.LicenseConfigWebScript"
		parent="webscript">
		<property name="featureRestrictionService" ref="FeatureRestrictionService" />
	</bean>

	<!-- Collabora Status -->

	<bean id="webscript.fr.jeci.collabora.admin.admin-status.get"
		class="fr.jeci.collabora.alfresco.remoteconfig.CollaboraStatusWebScript"
		parent="webscript">
		<property name="wopiDiscovery" ref="WopiDiscovery" />
		<property name="collaboraPublicUrl" value="${collabora.public.url}" />
		<property name="remoteConfigService" ref="RemoteConfigService" />
	</bean>

	<!-- Remote Configuration Webscripts (public, no auth) -->

	<bean id="webscript.fr.jeci.collabora.remote-config.remote-config.get"
		class="fr.jeci.collabora.alfresco.remoteconfig.RemoteConfigWebScript"
		parent="webscript">
		<property name="remoteConfigService" ref="RemoteConfigService" />
	</bean>

	<bean id="webscript.fr.jeci.collabora.remote-config.fonts-config.get"
		class="fr.jeci.collabora.alfresco.remoteconfig.FontsConfigWebScript"
		parent="webscript">
		<property name="remoteConfigService" ref="RemoteConfigService" />
	</bean>

	<bean id="webscript.fr.jeci.collabora.fonts.font-file.get"
		class="fr.jeci.collabora.alfresco.remoteconfig.FontFileWebScript"
		parent="webscript">
		<property name="remoteConfigService" ref="RemoteConfigService" />
	</bean>

	<!-- Remote Configuration Admin Webscripts -->

	<bean id="webscript.fr.jeci.collabora.admin.admin-remote-config.get"
		class="fr.jeci.collabora.alfresco.remoteconfig.AdminGetConfigWebScript"
		parent="webscript">
		<property name="remoteConfigService" ref="RemoteConfigService" />
	</bean>

	<bean id="webscript.fr.jeci.collabora.admin.admin-remote-config.post"
		class="fr.jeci.collabora.alfresco.remoteconfig.AdminUpdateConfigWebScript"
		parent="webscript">
		<property name="remoteConfigService" ref="RemoteConfigService" />
	</bean>

	<bean id="webscript.fr.jeci.collabora.admin.admin-fonts.get"
		class="fr.jeci.collabora.alfresco.remoteconfig.AdminListFontsWebScript"
		parent="webscript">
		<property name="remoteConfigService" ref="RemoteConfigService" />
	</bean>

	<bean id="webscript.fr.jeci.collabora.admin.admin-fonts.post"
		class="fr.jeci.collabora.alfresco.remoteconfig.AdminUploadFontWebScript"
		parent="webscript">
		<property name="remoteConfigService" ref="RemoteConfigService" />
	</bean>

	<bean id="webscript.fr.jeci.collabora.admin.admin-fonts-delete.delete"
		class="fr.jeci.collabora.alfresco.remoteconfig.AdminDeleteFontWebScript"
		parent="webscript">
		<property name="remoteConfigService" ref="RemoteConfigService" />
	</bean>

</beans>
